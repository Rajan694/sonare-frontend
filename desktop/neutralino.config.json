{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "app.sonare.desktop",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": true,
    "writeToLogFile": true
  },
  "nativeAllowList": [
    "app.exit",
    "os.setTray",
    "os.showMessageBox",
    "os.open",
    "os.getPath",
    "os.showFolderDialog",
    "storage.setData",
    "storage.getData",
    "filesystem.readDirectory",
    "filesystem.getStats",
    "filesystem.readBinaryFile",
    "filesystem.readFile",
    "filesystem.createDirectory",
    "filesystem.appendBinaryFile",
    "filesystem.remove",
    "filesystem.move",
    "debug.log"
  ],
  "modes": {
    "window": {
      "title": "Sonare",
      "width": 1440,
      "height": 900,
      "minWidth": 1100,
      "minHeight": 680,
      "center": true,
      "fullScreen": false,
      "alwaysOnTop": false,
      "icon": "/resources/icons/appIcon.png",
      "enableInspector": false,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": false
    },
    "browser": {
      "nativeBlockList": ["filesystem.*"]
    }
  },
  "cli": {
    "binaryName": "sonare-desktop",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "binaryVersion": "6.9.0",
    "frontendLibrary": {
      "patchFile": "/index.html",
      "devUrl": "http://localhost:5183",
      "projectPath": "./",
      "initCommand": "npm install",
      "devCommand": "npm run dev",
      "buildCommand": "npm run build"
    }
  }
}
