# Sonare Desktop / Web Environment Variables

# Which API a build talks to: dev (default) uses VITE_API_BASE, prod uses VITE_API_BASE_PROD
# and drops the dev auto-login below. Usually set per build instead of here:
#   SONARE_ENV=prod npm run build          (the web server)
#   ../buildFE.sh linux --env=prod         (desktop packages)
# SONARE_ENV=dev
VITE_API_BASE=http://127.0.0.1:3010/api/v1
VITE_API_BASE_PROD=https://api.sonare.dev/api/v1

# Development Auto-Login credentials (optional)
VITE_DEV_EMAIL=
VITE_DEV_PASSWORD=
