{
  "$meta": {
    "name": "Sonare",
    "version": "1.0.0",
    "theme": "dark-only",
    "note": "Primitives are private; build against the semantic layer. Every value below is the exact value used in the screens."
  },
  "primitive": {
    "color": {
      "base/black": "#000000",
      "base/white": "#FFFFFF",
      "neutral/950": "#060607",
      "neutral/900": "#0B0B0D",
      "neutral/850": "#111114",
      "neutral/800": "#17171B",
      "neutral/750": "#1E1E23",
      "neutral/700": "#26262C",
      "neutral/600": "#33333B",
      "neutral/500": "#4A4A55",
      "neutral/400": "#6B6B78",
      "neutral/350": "#7E7E8C",
      "neutral/300": "#8E8E9C",
      "neutral/250": "#9A9AA8",
      "neutral/200": "#B4B4C0",
      "neutral/100": "#DCDCE3",
      "neutral/50": "#F4F4F7",
      "green/900": "#004E2F",
      "green/800": "#007446",
      "green/700": "#009A5D",
      "green/600": "#00C074",
      "green/500": "#00E28A",
      "green/400": "#1FE795",
      "green/300": "#46EFAB",
      "green/200": "#7CF7C5",
      "green/100": "#B8FFE0",
      "green/50": "#E6FFF4",
      "gold/900": "#3D2E0C",
      "gold/600": "#C98A15",
      "gold/500": "#FFC24D",
      "gold/300": "#FFD98A",
      "red/900": "#3D1017",
      "red/600": "#E03449",
      "red/500": "#FF4D5E",
      "blue/900": "#0B2A47",
      "blue/500": "#4DA3FF",
      "violet/900": "#231E4D",
      "violet/500": "#8B7CFF",
      "cyan/500": "#31D9E8",
      "magenta/500": "#FF5EA8",
      "orange/500": "#FF8A3D"
    }
  },
  "semantic": {
    "color": {
      "bg/base": {
        "value": "#000000",
        "css": "--bg",
        "use": "Page canvas. True black."
      },
      "bg/surface": {
        "value": "#0B0B0D",
        "css": "--s1",
        "use": "Cards, sheets, playlist hero."
      },
      "bg/surface-raised": {
        "value": "#111114",
        "css": "--s2",
        "use": "Player bar, menus, tiles, fields."
      },
      "bg/surface-overlay": {
        "value": "#17171B",
        "css": "--s3",
        "use": "Hover, chips, icon boxes."
      },
      "bg/inset": {
        "value": "#060607",
        "css": "--s0",
        "use": "Sidebar, inset panels."
      },
      "bg/active": {
        "value": "#1E1E23",
        "css": "--s4",
        "use": "Pressed rows."
      },
      "border/subtle": {
        "value": "#1A1A1F",
        "css": "--ln",
        "use": "Hairlines between rows and regions."
      },
      "border/default": {
        "value": "#26262C",
        "css": "--ln2",
        "use": "Card and control borders."
      },
      "border/strong": {
        "value": "#33333B",
        "css": "--ln3",
        "use": "Slider rails, drag outlines."
      },
      "text/primary": {
        "value": "#FFFFFF",
        "css": "--t1",
        "use": "Titles, active track. 21:1 on bg/base."
      },
      "text/secondary": {
        "value": "#9A9AA8",
        "css": "--t2",
        "use": "Artist, album, body copy. 7.6:1."
      },
      "text/tertiary": {
        "value": "#7E7E8C",
        "css": "--t3",
        "use": "Metadata, timestamps. 5.3:1 — the contrast floor."
      },
      "text/disabled": {
        "value": "#5A5A66",
        "css": "--t4",
        "use": "Disabled only. Never for readable text."
      },
      "accent/primary": {
        "value": "#00E28A",
        "css": "--acc",
        "use": "Play, progress, selection, ONLINE. 12.2:1."
      },
      "accent/hover": {
        "value": "#1FE795",
        "css": "--acc2",
        "use": "Accent hover."
      },
      "accent/pressed": {
        "value": "#00C074",
        "css": "--acc3",
        "use": "Accent pressed."
      },
      "accent/subtle": {
        "value": "rgba(0,226,138,.12)",
        "css": "--accbg",
        "use": "Tinted accent backgrounds."
      },
      "status/offline": {
        "value": "#FFC24D",
        "css": "--gold",
        "use": "On-device files and Offline Mode. 13.1:1."
      },
      "status/offline-bg": {
        "value": "rgba(255,194,77,.12)",
        "css": "--goldbg",
        "use": "Offline banners and chips."
      },
      "status/error": {
        "value": "#FF4D5E",
        "css": "--red",
        "use": "Destructive actions."
      },
      "status/downloading": {
        "value": "#4DA3FF",
        "css": "--blue",
        "use": "Sync and download in progress."
      }
    }
  },
  "spacing": {
    "2xs": 2,
    "xs": 4,
    "sm": 6,
    "md": 8,
    "lg": 12,
    "xl": 16,
    "2xl": 20,
    "3xl": 24,
    "4xl": 32,
    "5xl": 40,
    "6xl": 48,
    "7xl": 64,
    "8xl": 80,
    "9xl": 120
  },
  "radius": {
    "none": 0,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "2xl": 28,
    "3xl": 40,
    "full": 999
  },
  "size": {
    "icon": {
      "xs": 14,
      "sm": 16,
      "md": 20,
      "lg": 24,
      "xl": 28,
      "2xl": 32
    },
    "control": {
      "xs": 28,
      "sm": 32,
      "md": 40,
      "lg": 48,
      "xl": 56,
      "2xl": 64,
      "3xl": 72
    },
    "artwork": {
      "xs": 40,
      "sm": 48,
      "md": 56,
      "lg": 64,
      "xl": 96,
      "2xl": 160,
      "3xl": 200
    },
    "nav": {
      "mobile-tab-bar": 64,
      "mini-player": 64,
      "desktop-sidebar": 260,
      "desktop-player": 88,
      "web-player": 80,
      "topbar": 64
    }
  },
  "typography": {
    "family": {
      "sans": "Geist, system-ui, -apple-system, sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, monospace"
    },
    "styles": {
      "display/large": {
        "size": 40,
        "line": 44,
        "weight": 700,
        "tracking": "-0.6px",
        "class": "t-dis"
      },
      "display/medium": {
        "size": 32,
        "line": 36,
        "weight": 700,
        "tracking": "-0.4px",
        "class": "t-dis2"
      },
      "headline/large": {
        "size": 24,
        "line": 30,
        "weight": 600,
        "tracking": "-0.2px",
        "class": "t-h1"
      },
      "headline/medium": {
        "size": 20,
        "line": 26,
        "weight": 600,
        "tracking": "-0.1px",
        "class": "t-h2"
      },
      "title/large": {
        "size": 17,
        "line": 24,
        "weight": 600,
        "class": "t-tl"
      },
      "title/medium": {
        "size": 15,
        "line": 22,
        "weight": 500,
        "class": "t-tm"
      },
      "body/large": {
        "size": 15,
        "line": 22,
        "weight": 400,
        "class": "t-bl"
      },
      "body/medium": {
        "size": 14,
        "line": 20,
        "weight": 400,
        "class": "t-bm"
      },
      "body/small": {
        "size": 13,
        "line": 18,
        "weight": 400,
        "class": "t-bs"
      },
      "label/large": {
        "size": 13,
        "line": 16,
        "weight": 500,
        "class": "t-ll"
      },
      "label/medium": {
        "size": 12,
        "line": 16,
        "weight": 500,
        "tracking": "0.2px",
        "class": "t-lm"
      },
      "label/small": {
        "size": 11,
        "line": 14,
        "weight": 500,
        "tracking": "0.4px",
        "class": "t-ls"
      },
      "overline": {
        "size": 11,
        "line": 14,
        "weight": 600,
        "tracking": "0.9px",
        "transform": "uppercase",
        "class": "t-ov"
      },
      "mono/medium": {
        "size": 13,
        "line": 16,
        "weight": 500,
        "family": "mono",
        "numerals": "tabular",
        "class": "t-mono"
      },
      "mono/small": {
        "size": 11,
        "line": 14,
        "weight": 500,
        "family": "mono",
        "numerals": "tabular",
        "class": "t-mono-s"
      }
    }
  },
  "elevation": {
    "01-raised": "0 1px 2px rgba(0,0,0,.40), 0 0 1px rgba(0,0,0,.24)",
    "02-card": "0 4px 12px -2px rgba(0,0,0,.50), 0 1px 2px rgba(0,0,0,.30)",
    "03-overlay": "0 12px 32px -6px rgba(0,0,0,.60), 0 2px 6px rgba(0,0,0,.35)",
    "04-modal": "0 24px 64px -12px rgba(0,0,0,.70), 0 4px 12px rgba(0,0,0,.40)",
    "player": "0 -8px 32px -8px rgba(0,0,0,.75)",
    "glow/accent": "0 6px 28px -2px rgba(0,226,138,.55)",
    "glow/offline": "0 4px 20px -4px rgba(255,194,77,.32)"
  },
  "breakpoints": {
    "mobile": 390,
    "tablet": 834,
    "web": 1280,
    "desktop": 1440
  }
}