<?xml version="1.0" encoding="utf-8"?>
<!-- Geist (SIL OFL 1.1, from the `geist` npm package), the design system's UI face. -->
<font-family xmlns:app="http://schemas.android.com/apk/res-auto">
  <font app:fontStyle="normal" app:fontWeight="400" app:font="@font/geist_regular" />
  <font app:fontStyle="normal" app:fontWeight="500" app:font="@font/geist_medium" />
  <font app:fontStyle="normal" app:fontWeight="600" app:font="@font/geist_semibold" />
  <font app:fontStyle="normal" app:fontWeight="700" app:font="@font/geist_bold" />
</font-family>
