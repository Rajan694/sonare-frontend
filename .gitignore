# Repo-wide rules. mobile/ and other-screens/ each keep their own .gitignore
# for stack-specific artifacts (Android/Xcode/Metro, Neutralino/Vite).

# Dependencies
node_modules/

# Build output
dist/
build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment / secrets
.env
.env.*
!.env.example

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local tool state
.cache/
*.tsbuildinfo
