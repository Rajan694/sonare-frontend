# Single .gitignore for the whole frontend repo: mobile/ (React Native) and
# other-screens/ (React + Vite on NeutralinoJS). Rules that only make sense for
# one of them are path-anchored.

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
/mobile/vendor/bundle/
**/Pods/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ── Build output ──────────────────────────────────────────────────────────────
build/
dist/
out/
*.tsbuildinfo

# Vite output — this is Neutralino's documentRoot / cli.resourcesPath
/other-screens/resources/

# Neutralino binaries
/other-screens/bin/

# ── Android ───────────────────────────────────────────────────────────────────
.gradle/
.cxx/
local.properties
*.iml
*.hprof
*.keystore
!debug.keystore
.kotlin/

# ── iOS / Xcode ───────────────────────────────────────────────────────────────
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata
*.xccheckout
*.moved-aside
DerivedData
*.hmap
*.ipa
*.xcuserstate
**/.xcode.env.local

# ── React Native / Metro ──────────────────────────────────────────────────────
*.jsbundle
.metro-health-check*

# fastlane — regenerate screenshots rather than committing them.
# https://docs.fastlane.tools/best-practices/source-control/
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# ── Neutralino runtime state ──────────────────────────────────────────────────
/other-screens/.storage/
/other-screens/.tmp/

# ── Tests ─────────────────────────────────────────────────────────────────────
coverage/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Editors ───────────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.lite_workspace.lua
*.swp
*.swo

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Local tool state ──────────────────────────────────────────────────────────
.cache/
